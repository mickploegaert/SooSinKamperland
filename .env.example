# Kopieer naar .env.local en vul in. .env.local komt nooit in git.

# Welke opslag gebruikt wordt: "local" (JSON-bestand in .data/, standaard) of "supabase".
DATA_PROVIDER=local

# Geheim voor het ondertekenen van de sessiecookie (verplicht in productie bij
# DATA_PROVIDER=local; bij Supabase beheert Supabase Auth de sessie).
# Genereer met: openssl rand -base64 32
SESSION_SECRET=

# Eerste beheerdersaccount voor de lokale opslag (alleen gebruikt bij het aanmaken van .data/).
# Bij Supabase maak je beheerders aan in het dashboard (zie docs/supabase.md).
SEED_ADMIN_USERNAME=beheerder
SEED_ADMIN_EMAIL=beheerder@soosinkamperland.nl
SEED_ADMIN_PASSWORD=SoosBeheer2026!

# Supabase (gebruikt bij DATA_PROVIDER=supabase, zie docs/supabase.md).
# Alle drie staan in het Supabase-dashboard: Project URL via de knop "Connect",
# de sleutels onder Project Settings > API Keys.
# Geen NEXT_PUBLIC_-voorvoegsel: de sleutels worden alleen op de server gebruikt.
SUPABASE_URL=
# Publishable key (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Geheim houden: omzeilt RLS. Nooit in git of in de browser.
SUPABASE_SECRET_KEY=

# SumUp (US15/US16). Kassa en SumUp staan uit tot SUMUP_ENABLED=true.
SUMUP_ENABLED=
# Zonder sleutel worden in ontwikkeling demogegevens getoond.
# API-sleutel (sup_sk_...) en merchant code staan in het SumUp-dashboard onder Developers.
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
# Zet op true om ook in productie (bijv. voor een demo) voorbeeldgegevens te tonen.
SUMUP_DEMO=
