# Kopieer naar .env.local en vul in. .env.local komt nooit in git.

# Welke opslag gebruikt wordt: "local" (JSON-bestand in .data/, standaard) of "supabase".
DATA_PROVIDER=local

# Geheim voor het ondertekenen van de sessiecookie (verplicht in productie).
# Genereer met: openssl rand -base64 32
SESSION_SECRET=

# Eerste beheerdersaccount voor de lokale opslag (alleen gebruikt bij het aanmaken van .data/).
SEED_ADMIN_USERNAME=beheerder
SEED_ADMIN_EMAIL=beheerder@soosinkamperland.nl
SEED_ADMIN_PASSWORD=SoosBeheer2026!

# Supabase (nog niet in gebruik, zie docs/supabase.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
